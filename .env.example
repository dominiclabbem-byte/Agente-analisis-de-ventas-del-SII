# ─── SII ────────────────────────────────────────────────────────────────────
SII_RUT=12345678-9          # RUT de la empresa (con dígito verificador)
SII_CLAVE=tu_clave_sii      # Clave tributaria SII
SII_AMBIENTE=CERTIFICACION  # CERTIFICACION o PRODUCCION

# ─── Datos empresa ───────────────────────────────────────────────────────────
EMPRESA_RAZON_SOCIAL=Mi Empresa SpA
EMPRESA_GIRO=Comercio al por mayor
EMPRESA_DIRECCION=Av. Principal 123
EMPRESA_COMUNA=Santiago

# ─── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
# 1. Crea una app en https://developers.facebook.com/apps/
# 2. Agrega el producto "WhatsApp" a tu app
# 3. En WhatsApp > Configuración de la API encontrarás:
#    - Phone Number ID (no es el número de teléfono, es el ID del número)
#    - Token de acceso temporal (para pruebas) o genera uno permanente
# 4. Para producción: verifica tu cuenta de Meta Business y solicita número aprobado
META_WHATSAPP_PHONE_NUMBER_ID=123456789012345   # ID del número en Meta
META_WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx  # Token de acceso de la app
META_WHATSAPP_API_VERSION=v19.0                 # Versión de la Graph API

# ─── Anthropic / Claude ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Hora en que se envían los recordatorios cada lunes (formato HH:MM, 24h)
REMINDER_TIME=09:00
TIMEZONE=America/Santiago

# ─── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/sii_agent.db
