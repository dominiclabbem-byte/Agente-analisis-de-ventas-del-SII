# ─── SII ────────────────────────────────────────────────────────────────────
SII_RUT=12345678-9          # RUT de la empresa (con dígito verificador)
SII_CLAVE=tu_clave_sii      # Clave tributaria SII
SII_AMBIENTE=CERTIFICACION  # CERTIFICACION o PRODUCCION

# ─── Datos empresa ───────────────────────────────────────────────────────────
EMPRESA_RAZON_SOCIAL=Mi Empresa SpA
EMPRESA_GIRO=Comercio al por mayor
EMPRESA_DIRECCION=Av. Principal 123
EMPRESA_COMUNA=Santiago

# ─── WhatsApp (Twilio) ───────────────────────────────────────────────────────
# Crea tu cuenta en https://www.twilio.com/try-twilio
# Activa WhatsApp Sandbox en: Messaging > Try it out > Send a WhatsApp message
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=+14155238886   # Número sandbox de Twilio (o tu número aprobado)

# ─── Anthropic / Claude ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Hora en que se envían los recordatorios cada lunes (formato HH:MM, 24h)
REMINDER_TIME=09:00
TIMEZONE=America/Santiago

# ─── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/sii_agent.db
